instance_name = "attic-example"
host_name     = "attic"
image_id      = "ac5fc61e-258b-4f8b-a06c-229c26f1e38f"
flavor_name   = "<OPENSTACK_FLAVOR_NAME>"
network_name  = ""
network_id    = ""
subnet_id     = ""
keypair_name  = "<YOUR_KEYPAIR_NAME>"
public_key_path = ""

ssh_allowed_cidrs = ["<YOUR_IP>/32"]

extra_tcp_ingress_rules = [
  {
    name  = "atticd"
    port  = 8080
    cidrs = ["<YOUR_IP>/32"]
  }
]

allocate_floating_ip = false
external_network_name = ""

metadata = {
  environment = "production"
  service     = "attic"
}

tags = ["nixos", "openstack", "attic"]

ssh_user = "deploy"

# Alternative without a floating IP:
# allocate_floating_ip   = false
# external_network_name  = ""
